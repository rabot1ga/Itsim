# ─────────────────────────────────────────────────────────────────────────────
# IT Life Simulator — environment
#
# Copy to `.env` for local development:  cp .env.example .env
# Every variable below is read in packages/server/src/config.ts (server) or
# packages/bot/src/index.ts (bot). Production refuses to start when the
# security-relevant ones are missing — see docs/deploy.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Common ------------------------------------------------------------------

# development | production
NODE_ENV=development

# BotFather token. Without it the server runs in DEV MODE:
# Telegram initData is NOT verified and anyone can claim any user id.
BOT_TOKEN=

# Public URL of the Mini App (deep links, invoices, bot buttons)
MINI_APP_URL=http://localhost:5173

# --- Game API server ----------------------------------------------------------

PORT=3001
HOST=0.0.0.0

# Signing key for /api/auth/telegram sessions.
# Falls back to BOT_TOKEN, then to the PUBLIC default "dev-secret" (dev only).
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Where player saves are written (JSON files, one per player)
DATA_DIR=./packages/server/data

# Secret you pass to setWebhook; Telegram echoes it in
# `X-Telegram-Bot-Api-Secret-Token`. Payment webhooks are rejected without it.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret between the bot and /api/admin/* (player summary, nudges,
# GDPR deletion). Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# Simulate Stars purchases via POST /api/payments/dev-complete.
# Defaults to true when BOT_TOKEN is empty; must be false in production.
ALLOW_MOCK_PAYMENTS=

# Per-IP rate limit
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute

# How long the leaderboard index may serve a cached full scan (ms)
LEADERBOARD_TTL_MS=15000

LOG_LEVEL=info

# --- Telegram bot --------------------------------------------------------------

BOT_PORT=3002

# polling | webhook | mock   (default: polling with a token, mock without)
BOT_MODE=

# Required for BOT_MODE=webhook
BOT_WEBHOOK_URL=

# Where the bot reaches the game API (server-to-server)
GAME_API_URL=http://127.0.0.1:3001

# "Your day bank is full" notifications
BOT_NUDGES=true
BOT_NUDGE_INTERVAL_MS=3600000
BOT_NUDGE_MIN_BANKED_DAYS=6
